{
  "name": "kehikko-diff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The diff of whichever change is selected on the canvas, read from the tracker CLI already on this machine. An app: its own page, its own port, its own cache. A host may frame it, and then it knows which refs to look at.",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "vite",
    "register": "bun run register.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "roadmap-module-protocol": "git+ssh://git@github.com/Jalez/kehikko-protocol.git#main",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.2.4"
  }
}
